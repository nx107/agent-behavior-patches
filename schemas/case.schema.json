{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "behavior-patch-cases"
    },
    "patchId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fixtureMetadata": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "const": "demo-fixture"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["classification", "generatedAt", "note"],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "patched": {
            "type": "string",
            "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "expected": {
            "type": "object",
            "properties": {
              "baselinePass": {
                "type": "boolean"
              },
              "patchedPass": {
                "type": "boolean"
              }
            },
            "required": ["baselinePass", "patchedPass"],
            "additionalProperties": false
          }
        },
        "required": ["id", "description", "baseline", "patched", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "kind", "patchId", "fixtureMetadata", "cases"],
  "additionalProperties": false
}
