{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "behavior-patch"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "instructions": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "supportedAdapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": ["capabilities"],
      "additionalProperties": false
    },
    "expectedContextCost": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["words", "tokens"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["unit", "value", "method"],
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "incompatibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problemReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": ["authors", "problemReferences"],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "verify-before-claim"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "requireCommandStart": {
          "type": "boolean",
          "const": true
        },
        "requireExitCode": {
          "type": "number",
          "const": 0
        },
        "requireSameRevision": {
          "type": "boolean",
          "const": true
        },
        "requireEvidenceBeforeClaim": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "type",
        "version",
        "requireCommandStart",
        "requireExitCode",
        "requireSameRevision",
        "requireEvidenceBeforeClaim"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": ["primary", "secondary"],
      "additionalProperties": false
    },
    "lastVerified": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "title",
    "summary",
    "category",
    "instructions",
    "languages",
    "supportedAdapters",
    "requires",
    "expectedContextCost",
    "risks",
    "incompatibilities",
    "provenance",
    "verifier",
    "metrics",
    "lastVerified"
  ],
  "additionalProperties": false
}
