{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "fixture-evaluation-result"
    },
    "patch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "const": "demo-fixture"
        },
        "generatedBy": {
          "type": "string",
          "const": "abp fixture runner"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "benchmark": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification",
        "generatedBy",
        "generatedAt",
        "benchmark",
        "note"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselinePassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patchedPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "improved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regressed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectationsMet": {
          "type": "boolean"
        }
      },
      "required": [
        "totalCases",
        "baselinePassed",
        "patchedPassed",
        "improved",
        "regressed",
        "unchanged",
        "expectationsMet"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "expected": {
            "type": "object",
            "properties": {
              "baselinePass": {
                "type": "boolean"
              },
              "patchedPass": {
                "type": "boolean"
              }
            },
            "required": ["baselinePass", "patchedPass"],
            "additionalProperties": false
          },
          "baseline": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "claimCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "verifiedClaimCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "non_monotonic_sequence",
                        "duplicate_command_start",
                        "duplicate_command_result",
                        "claim_without_evidence_reference",
                        "evidence_result_missing",
                        "evidence_not_before_claim",
                        "evidence_command_not_started",
                        "evidence_exit_nonzero",
                        "evidence_revision_mismatch",
                        "task_snapshot_missing_or_mismatch"
                      ]
                    },
                    "eventSeq": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["code", "eventSeq", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "passed",
              "claimCount",
              "verifiedClaimCount",
              "issues"
            ],
            "additionalProperties": false
          },
          "patched": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "claimCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "verifiedClaimCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "non_monotonic_sequence",
                        "duplicate_command_start",
                        "duplicate_command_result",
                        "claim_without_evidence_reference",
                        "evidence_result_missing",
                        "evidence_not_before_claim",
                        "evidence_command_not_started",
                        "evidence_exit_nonzero",
                        "evidence_revision_mismatch",
                        "task_snapshot_missing_or_mismatch"
                      ]
                    },
                    "eventSeq": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["code", "eventSeq", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "passed",
              "claimCount",
              "verifiedClaimCount",
              "issues"
            ],
            "additionalProperties": false
          },
          "effect": {
            "type": "string",
            "enum": ["improved", "regressed", "unchanged"]
          },
          "expectationMet": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "expected",
          "baseline",
          "patched",
          "effect",
          "expectationMet"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "patch",
    "provenance",
    "summary",
    "cases"
  ],
  "additionalProperties": false
}
